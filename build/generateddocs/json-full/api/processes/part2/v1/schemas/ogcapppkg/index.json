        {
          "language": "json",
          "ref": "https://geolabs.github.io/ogcapi-processes-all-as-bblocks/_sources/part2/v1/schemas/ogcapppkg/example.json",
          "url": "https://geolabs.github.io/ogcapi-processes-all-as-bblocks/build/tests/api/processes/part2/v1/schemas/ogcapppkg/example_1_1.json",
          "sizeBytes": 201,
          "code": "{\n  \"executionUnit\": {\n    \"href\": \"https://github.com/Terradue/ogc-eo-application-package-hands-on/releases/download/1.5.0/app-water-bodies-cloud-native.1.5.0.cwl\",\n    \"type\": \"application/cwl\"\n  }\n}"
        },
        {
          "language": "jsonld",
          "url": "https://geolabs.github.io/ogcapi-processes-all-as-bblocks/build/tests/api/processes/part2/v1/schemas/ogcapppkg/example_1_1.jsonld",
          "sizeBytes": 348,
          "code": "{\n  \"@context\": \"https://geolabs.github.io/ogcapi-processes-all-as-bblocks/build/annotated/api/processes/part2/v1/schemas/ogcapppkg/context.jsonld\",\n  \"executionUnit\": {\n    \"href\": \"https://github.com/Terradue/ogc-eo-application-package-hands-on/releases/download/1.5.0/app-water-bodies-cloud-native.1.5.0.cwl\",\n    \"type\": \"application/cwl\"\n  }\n}"
        },
