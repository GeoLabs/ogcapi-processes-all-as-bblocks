          "language": "ttl",
          "url": "https://geolabs.github.io/ogcapi-processes-all-as-bblocks/build/tests/api/processes/part2/v1/schemas/ogcapppkg/example_1_1.ttl",
          "sizeBytes": 325,
          "code": "@prefix proc: <https://w3id.org/ogc/api/processes/> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n\n[] proc:executionUnit \"{\\\"href\\\":\\\"https://github.com/Terradue/ogc-eo-application-package-hands-on/releases/download/1.5.0/app-water-bodies-cloud-native.1.5.0.cwl\\\",\\\"type\\\":\\\"application/cwl\\\"}\"^^rdf:JSON .\n\n"
