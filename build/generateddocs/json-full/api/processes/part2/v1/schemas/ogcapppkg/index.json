          "code": "{\n  \"title\": \"NDVI application package\",\n  \"executionUnit\": {\n    \"type\": \"docker\",\n    \"value\": {\n      \"image\": \"mydocker/ndvi:latest\",\n      \"bindings\": {\n        \"inputBindings\": {\n          \"inputImage\": {\n            \"prefix\": \"inputsImages=\",\n            \"inputSeparator\": \",\"\n          }\n        },\n        \"outputBindings\": {\n          \"outputImage\": {\n            \"glob\": \"$(\\\"/outputs/ndvi_\\\" + inputs.inputImage.basename)\"\n          }\n        }\n      },\n      \"deployment\": \"local\",\n      \"config\": {\n        \"cpuMin\": 2,\n        \"cpuMax\": 5,\n        \"memoryMin\": 1,\n        \"memoryMax\": 3\n      }\n    }\n  }\n}\n"
        },
        {
          "language": "jsonld",
          "url": "https://geolabs.github.io/ogcapi-processes-all-as-bblocks/build/tests/api/processes/part2/v1/schemas/ogcapppkg/example_2_1.jsonld",
