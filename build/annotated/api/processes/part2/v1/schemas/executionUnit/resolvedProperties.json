{"defs":{},"properties":[{"path":["type"],"description":"Type of execution unit.","required":true,"schema_type":"string","enum":["docker","oci"],"sources":["bblocks://ogc.api.processes.part2.v1.schemas.executionUnit"]},{"path":["image"],"description":"Container image reference for the execution unit.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.processes.part2.v1.schemas.executionUnit"]},{"path":["deployment"],"description":"Deployment information for the execution unit.","schema_type":"string","enum":["local","remote","hpc","cloud"],"sources":["bblocks://ogc.api.processes.part2.v1.schemas.executionUnit"]},{"path":["config"],"description":"Hardware requirements and configuration properties for executing the process.","schema_type":"object","sources":["bblocks://ogc.api.processes.part2.v1.schemas.executionUnit"]},{"path":["config","cpuMin"],"description":"Minimum number of CPUs required to run the process (unit is CPU core).","schema_type":"number","sources":["bblocks://ogc.api.processes.part2.v1.schemas.executionUnit"]},{"path":["config","cpuMax"],"description":"Maximum number of CPU dedicated to the process (unit is CPU core)","schema_type":"number","sources":["bblocks://ogc.api.processes.part2.v1.schemas.executionUnit"]},{"path":["config","memoryMin"],"description":"Minimum RAM memory required to run the application (unit is GB)","schema_type":"number","sources":["bblocks://ogc.api.processes.part2.v1.schemas.executionUnit"]},{"path":["config","memoryMax"],"description":"Maximum RAM memory dedicated to the application (unit is GB)","schema_type":"number","sources":["bblocks://ogc.api.processes.part2.v1.schemas.executionUnit"]},{"path":["config","storageTempMin"],"description":"Minimum required temporary storage size (unit is GB)","schema_type":"number","sources":["bblocks://ogc.api.processes.part2.v1.schemas.executionUnit"]},{"path":["config","storageOutputsMin"],"description":"Minimum required output storage size (unit is GB)","schema_type